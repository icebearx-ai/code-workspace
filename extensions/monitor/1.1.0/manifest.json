{
  "schemaVersion": 3,
  "extensionSpecVersion": 1,
  "experimental": true,
  "id": "monitor",
  "name": "Code Workspace Monitor",
  "version": "1.1.0",
  "entry": "init.js",
  "entrySha256": "b80b9b88aa25b523433a63983e8c74883c18153a95e14302c4c0af3709770ab1",
  "timeoutMs": 120000,
  "capabilities": {},
  "outputs": [
    {
      "id": "reporting-config",
      "kind": "file",
      "ownership": "seeded",
      "target": ".code-workspace/monitor-reporting.json"
    }
  ],
  "hooks": [
    { "id": "monitor-task-started", "event": "task.started", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 },
    { "id": "monitor-task-activity", "event": "task.activity", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 },
    { "id": "monitor-write-before", "event": "write.before", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 },
    { "id": "monitor-write-after", "event": "write.after", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 },
    { "id": "monitor-turn-ended", "event": "task.turn-ended", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 },
    { "id": "monitor-task-ended", "event": "task.ended", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 },
    { "id": "monitor-subagent-started", "event": "task.subagent-started", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 },
    { "id": "monitor-subagent-ended", "event": "task.subagent-ended", "command": "codew ext monitor report", "tools": ["codex", "claude"], "timeoutMs": 2 }
  ],
  "runtime": {
    "runtimeProtocolVersion": 1,
    "entry": "runtime.js",
    "entrySha256": "df2c30b8541373b6b140c99a2e7ac22d864104e24cdf6a388860480c6f1fdd41",
    "scope": "global",
    "mode": "service",
    "timeoutMs": 3000,
    "service": { "id": "monitor", "compatibilityGroup": "v1", "singleton": "user" }
  }
}
