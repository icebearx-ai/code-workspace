{
  "schemaVersion": 3,
  "extensionSpecVersion": 1,
  "experimental": true,
  "id": "zhuiyi-opensvn-mcp",
  "name": "Zhuiyi OpenSVN MCP",
  "description": "为 Codex 和 Claude 配置 OpenSVN MCP 服务",
  "version": "0.2.0",
  "entry": "init.js",
  "entrySha256": "9c9de6629fbe61372a433ab7c1ccb7318c5e692a374741d24ae0d94495fe5f48",
  "timeoutMs": 120000,
  "capabilities": {
    "networkHosts": ["gitee.com", "raw.giteeusercontent.com"]
  },
  "outputs": [
    {
      "id": "gitignore",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".gitignore",
      "format": "text"
    },
    {
      "id": "codex-config",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".codex/config.toml",
      "format": "toml",
      "tools": ["codex"]
    },
    {
      "id": "claude-config",
      "kind": "json-member",
      "ownership": "shared",
      "target": ".mcp.json",
      "selector": "/mcpServers/zhuiyi-opensvn",
      "tools": ["claude"]
    }
  ]
}
