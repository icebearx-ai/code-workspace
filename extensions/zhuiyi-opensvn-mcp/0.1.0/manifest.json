      "tools": ["codex"]
    },
    {
      "id": "claude-config",
      "kind": "json-member",
      "ownership": "shared",
      "target": ".mcp.json",
      "selector": "/mcpServers/zhuiyi-opensvn",
      "tools": ["claude"]
    }
  ]
}
