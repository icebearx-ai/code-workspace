{
  "schemaVersion": 3,
  "extensionSpecVersion": 1,
  "experimental": true,
  "id": "zhuiyi-opensvn-mcp",
  "name": "Zhuiyi OpenSVN MCP",
  "description": "为 Codex 和 Claude 配置 OpenSVN MCP 服务",
  "version": "0.1.0",
  "entry": "init.js",
  "entrySha256": "8ccd9af7c34f2431616c61693d68a9f0fea2f283348a0f921d0a75e7b043f4f4",
  "timeoutMs": 120000,
  "capabilities": {
    "networkHosts": ["gitee.com", "raw.giteeusercontent.com"]
  },
  "outputs": [
    {
      "id": "runtime",
      "kind": "directory",
      "ownership": "exclusive",
      "target": ".code-workspace/extensions/zhuiyi-opensvn-mcp/0.1.0"
    },
    {
      "id": "gitignore",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".gitignore",
      "format": "text"
    },
    {
      "id": "codex-config",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".codex/config.toml",
      "format": "toml",
      "tools": ["codex"]
    },
    {
      "id": "claude-config",
      "kind": "json-member",
      "ownership": "shared",
      "target": ".mcp.json",
      "selector": "/mcpServers/zhuiyi-opensvn",
      "tools": ["claude"]
    }
  ]
}
