{
  "schemaVersion": 3,
  "extensionSpecVersion": 1,
  "experimental": true,
  "id": "zhuiyi-jira-mcp",
  "name": "Zhuiyi Jira MCP",
  "version": "0.1.0",
  "entry": "init.js",
  "entrySha256": "53a814ffcbc5669a024f921c5c30e74385d334b749913b0212bdcc2e48a2e0bd",
  "timeoutMs": 120000,
  "capabilities": {
    "networkHosts": ["gitee.com", "raw.giteeusercontent.com"]
  },
  "outputs": [
    {
      "id": "runtime",
      "kind": "directory",
      "ownership": "exclusive",
      "target": ".code-workspace/extensions/zhuiyi-jira-mcp/0.1.0"
    },
    {
      "id": "gitignore",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".gitignore",
      "format": "text"
    },
    {
      "id": "codex-config",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".codex/config.toml",
      "format": "toml",
      "tools": ["codex"]
    },
    {
      "id": "claude-config",
      "kind": "json-member",
      "ownership": "shared",
      "target": ".mcp.json",
      "selector": "/mcpServers/zhuiyi-jira",
      "tools": ["claude"]
    }
  ]
}
