{
  "schemaVersion": 3,
  "extensionSpecVersion": 1,
  "experimental": true,
  "id": "zhuiyi-jira-mcp",
  "name": "Zhuiyi Jira MCP",
  "version": "1.1.0",
  "entry": "init.js",
  "entrySha256": "dd385601d83e9b2f64b100ac4c12229f626a4781d683e3f47f2120b2f29f334c",
  "timeoutMs": 120000,
  "capabilities": {
    "networkHosts": ["gitee.com", "raw.giteeusercontent.com"]
  },
  "outputs": [
    {
      "id": "gitignore",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".gitignore",
      "format": "text"
    },
    {
      "id": "codex-config",
      "kind": "text-block",
      "ownership": "shared",
      "target": ".codex/config.toml",
      "format": "toml",
      "tools": ["codex"]
    },
    {
      "id": "claude-config",
      "kind": "json-member",
      "ownership": "shared",
      "target": ".mcp.json",
      "selector": "/mcpServers/zhuiyi-jira",
      "tools": ["claude"]
    }
  ]
}
