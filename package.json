{
  "name": "code-workspace-zhuiyi",
  "version": "1.0.0-beta.5",
  "description": "Local multi-project registry and safety layer for AI coding workspaces",
  "author": "icebearx-ai",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "code-workspace": "bin/code-workspace.js",
    "codew": "bin/code-workspace.js",
    "code-w": "bin/code-workspace.js"
  },
  "files": [
    "assets",
    "bin",
    "src/cli.js",
    "src/cli",
    "src/index.js",
    "src/core",
    "src/hooks",
    "src/i18n",
    "src/init",
    "artifacts",
    "extensions",
    "docs/extension-development",
    "docs/extension-architecture.zh-CN.md",
    "spec",
    "docs/extensions.md",
    "docs/extensions.zh-CN.md",
    "schemas",
    ".env.example",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --test src/__test__/*.test.js",
    "check": "npm test && npm run cli:architecture-check && npm run pack:check",
    "cli:architecture-check": "node scripts/check-cli-architecture.js",
    "pack:extensions": "node scripts/pack-extensions.js --output dist/extensions",
    "pack:check": "npm pack --dry-run",
    "cli": "node bin/code-workspace.js",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@iarna/toml": "^2.2.5",
    "@npmcli/config": "^10.12.0",
    "js-yaml": "^5.2.2",
    "make-fetch-happen": "^15.0.6",
    "proper-lockfile": "^4.1.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.22"
  }
}
