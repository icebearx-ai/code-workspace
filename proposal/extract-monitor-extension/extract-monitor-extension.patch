--- /dev/null
+++ b/bin/code-workspace-monitor-hook.js
@@ -0,0 +1,18 @@
+#!/usr/bin/env node
+"use strict";
+
+const { getAdapter } = require("../src/hooks/adapters");
+const { runMonitorObserverStdin } = require("../extensions/monitor/0.1.0/runtime/observer");
+
+const provider = String(process.argv[2] || "").toLowerCase();
+let adapter;
+try { adapter = getAdapter(provider); } catch { adapter = null; }
+const neutral = () => adapter?.renderAcknowledgement?.("task.activity", {}) || {};
+if (!adapter) {
+  process.stdout.write(`${JSON.stringify(neutral())}\n`);
+  process.exitCode = 0;
+} else {
+  runMonitorObserverStdin(provider)
+    .then((output) => process.stdout.write(`${JSON.stringify(output)}\n`))
+    .catch(() => process.stdout.write(`${JSON.stringify(neutral())}\n`));
+}
