+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { spawnSync } = require("node:child_process");
+const test = require("node:test");
+const { createFileTransaction } = require("../core/transaction");
+const { migrateLegacyMonitorConfig } = require("../core/config");
+const { discoverExtensions, extensionCliIsLongRunning, resolveExtensionPlans, runExtensionCli, runExtensionCliLongRunning } = require("../core/extensions");
+const { parseCliOutput } = require("../cli/commands/ext");
+
+const root = path.resolve(__dirname, "..", "..");
+const cli = path.join(root, "bin", "code-workspace.js");
+const hook = path.join(root, "bin", "code-workspace-monitor-hook.js");
+function temp() { return fs.mkdtempSync(path.join(os.tmpdir(), "code-workspace-monitor-extension-")); }
+function run(cwd, args) { return spawnSync(process.execPath, [cli, ...args], { cwd, encoding: "utf8" }); }
+
+function writeLegacyWorkspace(workspace) {
+  fs.mkdirSync(path.join(workspace, ".code-workspace"), { recursive: true });
+  fs.writeFileSync(path.join(workspace, ".code-workspace", "config.yaml"), [
+    "schemaVersion: 2",
+    "workspace:",
+    "  name: legacy-monitor",
+    "  uuid: 123e4567-e89b-42d3-a456-426614174000",
+    "  language: zh-CN",
+    "monitor:",
+    "  enable: true",
+    "  url: http://127.0.0.1:8080",
+    "projects:",
+    "  ref: config-projects.yaml",
+    "",
+  ].join("\n"));
+  fs.writeFileSync(path.join(workspace, ".code-workspace", "config-projects.yaml"), "schemaVersion: 1\nprojects: []\n");
+  fs.mkdirSync(path.join(workspace, ".codex"), { recursive: true });
+  fs.writeFileSync(path.join(workspace, ".codex", "hooks.json"), `${JSON.stringify({
+    hooks: {
+      PreToolUse: [
+        { hooks: [{ type: "command", command: "code-w monitor report" }] },
+        { hooks: [{ type: "command", command: "code-workspace-task-hook codex" }] },
+        { hooks: [{ type: "command", command: "echo user" }] },
+      ],
+    },
+  }, null, 2)}\n`);
+}
+
+test("monitor extension installs config-monitor and observer hooks without core monitor config", () => {
+  const workspace = temp();
+  const result = run(workspace, ["init", ".", "--tools", "codex", "--extensions", "monitor", "--yes", "--json"]);
+  assert.equal(result.status, 0, result.stderr);
+  const config = fs.readFileSync(path.join(workspace, ".code-workspace", "config.yaml"), "utf8");
+  assert.doesNotMatch(config, /^monitor:/m);
+  assert.deepEqual(require("js-yaml").load(fs.readFileSync(path.join(workspace, ".code-workspace", "config-monitor.yaml"), "utf8")), { enable: true, url: "http://127.0.0.1:3211" });
+  const hooks = JSON.parse(fs.readFileSync(path.join(workspace, ".codex", "hooks.json"), "utf8"));
+  assert(hooks.hooks.PreToolUse.some((entry) => entry.hooks?.some((item) => /code-workspace-monitor-hook codex/.test(item.command))));
+  assert(hooks.hooks.PreToolUse.every((entry) => !entry.hooks?.some((item) => /code-workspace-task-hook/.test(item.command))));
+});
+
+test("monitor observer acknowledges failures open and never returns a write decision", () => {
+  const result = spawnSync(process.execPath, [hook, "codex"], {
+    cwd: temp(),
+    input: JSON.stringify({ hook_event_name: "PreToolUse", session_id: "s1", tool_name: "Write", cwd: "/missing/workspace" }),
+    encoding: "utf8",
+  });
+  assert.equal(result.status, 0);
+  assert.deepEqual(JSON.parse(result.stdout), {});
+  assert.doesNotMatch(fs.readFileSync(path.join(root, "src", "hooks", "monitor-observer.js"), "utf8"), /task-coordination|beforeWrite|afterWrite|applyTaskEvent/);
+});
+
+test("generic ext command runs monitor CLI without registry mutation", () => {
+  const result = spawnSync(process.execPath, [cli, "ext", "monitor", "status", "--json"], { cwd: root, encoding: "utf8" });
+  assert.equal(result.status, 0, result.stderr);
+  const output = JSON.parse(result.stdout);
+  assert.equal(output.ok, true);
+  assert.equal(output.data.extension.id, "monitor");
+  assert.equal(output.data.result.status, "available");
+});
+
+test("legacy monitor migration removes core config and replaces only the legacy Hook", () => {
+  const workspace = temp();
+  writeLegacyWorkspace(workspace);
+  const result = run(workspace, ["init", ".", "--tools", "codex", "--yes", "--json"]);
+  assert.equal(result.status, 0, result.stderr);
+  const config = require("js-yaml").load(fs.readFileSync(path.join(workspace, ".code-workspace", "config.yaml"), "utf8"));
+  assert.equal(config.monitor, undefined);
+  assert.deepEqual(require("js-yaml").load(fs.readFileSync(path.join(workspace, ".code-workspace", "config-monitor.yaml"), "utf8")), { enable: true, url: "http://127.0.0.1:8080" });
+  const hooks = JSON.parse(fs.readFileSync(path.join(workspace, ".codex", "hooks.json"), "utf8"));
+  const commands = hooks.hooks.PreToolUse.flatMap((entry) => entry.hooks.map((hookEntry) => hookEntry.command));
+  assert(commands.includes("code-workspace-monitor-hook codex"));
+  assert(commands.includes("code-workspace-task-hook codex"));
+  assert(commands.includes("echo user"));
+  assert(!commands.includes("code-w monitor report"));
+});
+
+test("uninstalling Monitor removes observer hooks but keeps config-monitor", () => {
+  const workspace = temp();
+  const initialized = run(workspace, ["init", ".", "--tools", "codex", "--extensions", "monitor", "--yes", "--json"]);
+  assert.equal(initialized.status, 0, initialized.stderr);
+  const configFile = path.join(workspace, ".code-workspace", "config-monitor.yaml");
+  fs.writeFileSync(configFile, "enable: false\nurl: http://127.0.0.1:8088\n");
+  const removed = run(workspace, ["extension", "uninstall", "monitor", "--yes", "--json"]);
+  assert.equal(removed.status, 0, removed.stderr);
+  assert.equal(fs.readFileSync(configFile, "utf8"), "enable: false\nurl: http://127.0.0.1:8088\n");
+  const hooksFile = path.join(workspace, ".codex", "hooks.json");
+  if (fs.existsSync(hooksFile)) {
+    const hooks = JSON.parse(fs.readFileSync(hooksFile, "utf8"));
+    assert(!JSON.stringify(hooks).includes("code-workspace-monitor-hook"));
+  }
+});
+
+test("explicitly selecting no extensions keeps the core config and hooks monitor-free", () => {
+  const workspace = temp();
+  const result = run(workspace, ["init", ".", "--tools", "codex", "--extensions", "none", "--yes", "--json"]);
+  assert.equal(result.status, 0, result.stderr);
+  const config = require("js-yaml").load(fs.readFileSync(path.join(workspace, ".code-workspace", "config.yaml"), "utf8"));
+  assert.equal(config.monitor, undefined);
+  assert.equal(fs.existsSync(path.join(workspace, ".code-workspace", "config-monitor.yaml")), false);
+  assert.equal(fs.existsSync(path.join(workspace, ".codex", "hooks.json")), false);
+});
+
+test("legacy monitor Hook migration also handles Hook-only workspaces", () => {
+  const workspace = temp();
+  fs.mkdirSync(path.join(workspace, ".codex"), { recursive: true });
+  fs.writeFileSync(path.join(workspace, ".codex", "hooks.json"), `${JSON.stringify({
+    hooks: {
+      PreToolUse: [
+        { hooks: [{ type: "command", command: "code-w monitor report --legacy" }] },
+        { hooks: [{ type: "command", command: "echo user" }] },
+      ],
+    },
+  }, null, 2)}\n`);
+  const result = migrateLegacyMonitorConfig(workspace, { hookMode: "replace" });
+  assert.equal(result.configAction, "skip");
+  assert.equal(fs.existsSync(path.join(workspace, ".code-workspace", "config-monitor.yaml")), false);
+  const commands = JSON.parse(fs.readFileSync(path.join(workspace, ".codex", "hooks.json"), "utf8"))
+    .hooks.PreToolUse.flatMap((entry) => entry.hooks.map((hookEntry) => hookEntry.command));
+  assert(commands.includes("code-workspace-monitor-hook codex"));
+  assert(commands.includes("echo user"));
+  assert(!commands.some((command) => /code-w monitor report/.test(command)));
+});
+
+test("legacy monitor migration can be rolled back with the enclosing file transaction", () => {
+  const workspace = temp();
+  writeLegacyWorkspace(workspace);
+  const files = [
+    path.join(workspace, ".code-workspace", "config.yaml"),
+    path.join(workspace, ".code-workspace", "config-monitor.yaml"),
+    path.join(workspace, ".code-workspace", "state.json"),
+    path.join(workspace, ".codex", "hooks.json"),
+    path.join(workspace, ".claude", "settings.json"),
+  ];
+  const before = files.map((file) => fs.existsSync(file) ? fs.readFileSync(file) : null);
+  const transaction = createFileTransaction(files);
+  migrateLegacyMonitorConfig(workspace, { transaction, hookMode: "replace" });
+  const failure = new Error("injected migration failure");
+  transaction.rollback(failure);
+  for (const [index, file] of files.entries()) {
+    if (before[index]) assert.deepEqual(fs.readFileSync(file), before[index], file);
+    else assert.equal(fs.existsSync(file), false, file);
+  }
+  assert.equal(failure.details.workspaceRolledBack, true);
+});
+
+test("observer loading does not eagerly load write-protection capability classification", () => {
+  const observer = path.join(root, "extensions", "monitor", "0.1.0", "runtime", "observer.js");
+  delete require.cache[require.resolve(observer)];
+  for (const key of Object.keys(require.cache)) if (key.endsWith(`${path.sep}hooks${path.sep}adapters${path.sep}write-capabilities.js`)) delete require.cache[key];
+  require(observer);
+  assert.equal(Object.keys(require.cache).some((key) => key.endsWith(`${path.sep}hooks${path.sep}adapters${path.sep}write-capabilities.js`)), false);
+});
+
+test("generic extension CLI preserves passthrough and long-running declarations", async () => {
+  const catalog = discoverExtensions({ tolerant: false });
+  const monitor = resolveExtensionPlans(catalog, ["monitor"], { tools: ["codex"], state: { schemaVersion: 1, experimental: true, extensions: {} } })[0];
+  assert.equal(extensionCliIsLongRunning(monitor, []), true);
+  assert.equal(extensionCliIsLongRunning(monitor, ["serve", "--port", "3211"]), true);
+  assert.equal(extensionCliIsLongRunning(monitor, ["status"]), false);
+  const fakeChild = {
+    once(event, listener) { this[`on${event}`] = listener; return this; },
+    kill() {},
+  };
+  const promise = runExtensionCliLongRunning(monitor, { marker: "passthrough" }, ["serve", "--port", "3211"], {
+    spawn() {
+      process.nextTick(() => fakeChild.onspawn?.());
+      process.nextTick(() => fakeChild.onexit?.(0, null));
+      return fakeChild;
+    },
+  });
+  const result = await promise;
+  assert.equal(result.longRunning, true);
+  assert.equal(result.status, 0);
+});
+
+function makeCliPlan(sourceRoot, body, options = {}) {
+  const file = path.join(sourceRoot, "cli.js");
+  fs.writeFileSync(file, body);
+  const digest = require("node:crypto").createHash("sha256").update(fs.readFileSync(file)).digest("hex");
+  return {
+    id: options.id || "test-extension",
+    version: "1.0.0",
+    extensionSpecVersion: 1,
+    sourceRoot,
+    cliFile: file,
+    cliEntrySha256: digest,
+    cli: { entry: "cli.js", entrySha256: digest, timeoutMs: options.timeoutMs || 300, scope: "global", protocolVersion: 1, longRunning: false },
+  };
+}
+
+test("extension CLI host rejects timeout, non-zero exit, stale entry and oversized output", () => {
+  const envelope = (data) => `process.stdout.write(${JSON.stringify(JSON.stringify({ schemaVersion: 1, extensionSpecVersion: 1, extension: { id: "test-extension", version: "1.0.0" }, data }))});`;
+  const timeoutPlan = makeCliPlan(temp(), "setTimeout(() => {}, 200);");
+  timeoutPlan.cli.timeoutMs = 20;
+  assert.throws(() => runExtensionCli(timeoutPlan, null, []), (error) => error.code === "EXTENSION_CLI_TIMEOUT");
+
+  const failedPlan = makeCliPlan(temp(), "process.exit(7);");
+  assert.throws(() => runExtensionCli(failedPlan, null, []), (error) => error.code === "EXTENSION_CLI_FAILED" && error.details.exitCode === 7);
+
+  const stalePlan = makeCliPlan(temp(), envelope({ ok: true }));
+  fs.appendFileSync(stalePlan.cliFile, "\n");
+  assert.throws(() => runExtensionCli(stalePlan, null, []), (error) => error.code === "EXTENSION_CLI_PLAN_STALE");
+
+  const outputPlan = makeCliPlan(temp(), envelope({ ok: true }));
+  assert.throws(() => runExtensionCli(outputPlan, null, [], {
+    spawnSync() { return { status: 0, stdout: "x".repeat(1024 * 1024 + 1), stderr: "" }; },
+  }), (error) => error.code === "EXTENSION_CLI_OUTPUT_LIMIT");
+
+  const malformed = { ...outputPlan, cliEntrySha256: outputPlan.cliEntrySha256, cli: { ...outputPlan.cli } };
+  const raw = runExtensionCli(malformed, null, [], { spawnSync() { return { status: 0, stdout: "not-json", stderr: "" }; } });
+  assert.throws(() => parseCliOutput(raw.stdout, malformed), (error) => error.code === "EXTENSION_CLI_RESULT_INVALID");
+});
