@@ -0,0 +1,61 @@
+"use strict";
+
+const {
+  findWorkspaceRoot,
+  loadConfigProjection,
+  readExtensionConfig,
+} = require("../../../../src/core/config");
+const { getAdapter } = require("../../../../src/hooks/adapters");
+const { reportHookEvent } = require("./index");
+const { normalizeMonitor } = require("./config");
+
+/**
+ * Monitor's observer protocol is deliberately separate from task
+ * coordination. It only reports a normalized observation and always returns
+ * the provider's neutral acknowledgement, even when configuration or the
+ * global Monitor service is unavailable.
+ */
+async function runMonitorObserver(provider, input, options = {}) {
+  const adapter = getAdapter(provider);
+  const normalized = adapter.normalizeInput(input, options);
+  const root = options.workspaceRoot || findWorkspaceRoot(normalized?.cwd || process.cwd());
+  if (!root) return adapter.renderAcknowledgement("task.activity", {});
+  try {
+    const identity = loadConfigProjection(root, ["identity"]).workspace;
+    const extensionConfig = readExtensionConfig(root, "monitor", {
+      defaultValue: { enable: true, url: "http://127.0.0.1:3211" },
+    });
+    const monitor = normalizeMonitor(extensionConfig.value);
+    await reportHookEvent({
+      ...input,
+      provider,
+      hook_event_name: normalized.nativeEventName,
+      session_id: normalized.nativeSessionId,
+      turn_id: input?.turn_id || input?.turnId || null,
+      tool_name: normalized.tool?.name || null,
+      tool_use_id: normalized.operationId || null,
+      cwd: normalized.cwd || null,
+      model: input?.model || input?.model_name || null,
+      permission_mode: input?.permission_mode || input?.permissionMode || null,
+      agent_id: normalized.agent?.agentId || null,
+      agent_type: normalized.agent?.agentType || null,
+    }, { workspace: identity, monitor }, options);
+  } catch {
+    // Failure-open is part of the observer protocol contract.
+  }
+  return adapter.renderAcknowledgement("task.activity", {});
+}
+
+async function runMonitorObserverStdin(provider, options = {}) {
+  const chunks = [];
+  for await (const chunk of process.stdin) chunks.push(chunk);
+  let input = {};
+  try {
+    input = JSON.parse(Buffer.concat(chunks).toString("utf8") || "{}");
+  } catch {
+    // A malformed observation is acknowledged neutrally.
+  }
+  return runMonitorObserver(provider, input, options);
+}
+
+module.exports = { runMonitorObserver, runMonitorObserverStdin };
