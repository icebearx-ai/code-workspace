diff --git a/extensions/monitor/0.1.0/cli.js b/extensions/monitor/0.1.0/cli.js
new file mode 100644
index 0000000000000000000000000000000000000000..295179b4dd9dbe76fc84a42d38b8d84af251840a
--- /dev/null
+++ b/extensions/monitor/0.1.0/cli.js
@@ -0,0 +1,38 @@
+#!/usr/bin/env node
+"use strict";
+
+const fs = require("node:fs");
+const { startMonitor, validatePort } = require("./runtime");
+
+const contextIndex = process.argv.indexOf("--context");
+const context = contextIndex >= 0 ? JSON.parse(fs.readFileSync(process.argv[contextIndex + 1], "utf8")) : {};
+const separator = process.argv.indexOf("--");
+const args = separator >= 0 ? process.argv.slice(separator + 1) : [];
+const command = ["status", "help", "serve"].includes(args[0]) ? args[0] : "serve";
+
+async function main() {
+  if (command === "status") {
+    process.stdout.write(`${JSON.stringify({ schemaVersion: 1, extensionSpecVersion: context.extensionSpecVersion || 1, extension: context.extension || { id: "monitor", version: "0.1.0" }, data: { runtime: "monitor", status: "available" }})}\n`);
+    return;
+  }
+  if (command === "help") {
+    process.stdout.write(`${JSON.stringify({ schemaVersion: 1, extensionSpecVersion: context.extensionSpecVersion || 1, extension: context.extension || { id: "monitor", version: "0.1.0" }, data: { usage: "code-w ext monitor [status|serve]" }, text: "Usage: code-w ext monitor [status|serve]" })}\n`);
+    return;
+  }
+  const portIndex = args.findIndex((value) => value === "--port" || value === "-p");
+  const portArg = portIndex >= 0 ? args[portIndex + 1] : null;
+  const port = validatePort(portArg || 3211);
+  const monitor = await startMonitor({ port });
+  process.stdout.write([
+    `Code Workspace Monitor listening on http://${monitor.host}:${monitor.port}`,
+    `Dashboard: http://${monitor.host}:${monitor.port}/`,
+    `Workspaces report to http://${monitor.host}:${monitor.port}/api/v1/events`,
+  ].join("\n") + "\n");
+  await new Promise((resolve) => {
+    const close = () => monitor.server.close(resolve);
+    process.once("SIGINT", close);
+    process.once("SIGTERM", close);
+  });
+}
+
+main().catch((error) => { process.stderr.write(`${error.message}\n`); process.exitCode = 1; });
