index 0000000000000000000000000000000000000000..5274bfa5ca02a20041ccf022c7e4529b48d4305f
--- /dev/null
+++ b/src/cli/commands/ext.js
@@ -0,0 +1,92 @@
+"use strict";
+
+const { findWorkspaceRoot, loadConfigProjection } = require("../../core/config");
+const { WorkspaceError } = require("../../core/errors");
+const {
+  discoverExtensions,
+  emptyExtensionState,
+  extensionCliIsLongRunning,
+  globalRuntimeRegistry,
+  loadExtensionState,
+  normalizeExtensionNames,
+  resolveExtensionPlans,
+  runExtensionCli,
+  runExtensionCliLongRunning,
+} = require("../../core/extensions");
+const { success } = require("../result");
+
+function parseCliOutput(text, plan) {
+  const raw = String(text || "").trim();
+  if (!raw) throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI returned an empty result`, { extension: plan.id });
+  let value;
+  try { value = JSON.parse(raw); }
+  catch (error) { throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI must return a JSON result envelope: ${error.message}`, { extension: plan.id }); }
+  if (!value || typeof value !== "object" || Array.isArray(value)) throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI result must be an object`, { extension: plan.id });
+  const allowed = new Set(["schemaVersion", "extensionSpecVersion", "extension", "data", "diagnostics", "text"]);
+  const unknown = Object.keys(value).find((key) => !allowed.has(key));
+  if (unknown) throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI result contains unsupported field ${unknown}`, { extension: plan.id, field: unknown });
+  if (value.schemaVersion !== 1 || value.extensionSpecVersion !== plan.extensionSpecVersion || value.extension?.id !== plan.id || value.extension?.version !== plan.version) {
+    throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI result identity does not match the planned extension`, { extension: plan.id });
+  }
+  const diagnostics = value.diagnostics === undefined ? [] : value.diagnostics;
+  if (!Array.isArray(diagnostics)) throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI diagnostics must be an array`, { extension: plan.id });
+  for (const diagnostic of diagnostics) {
+    if (!diagnostic || typeof diagnostic !== "object" || typeof diagnostic.code !== "string" || typeof diagnostic.message !== "string" || !["info", "warning", "error"].includes(diagnostic.severity || "warning")) {
+      throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI returned an invalid diagnostic`, { extension: plan.id });
+    }
+  }
+  if (value.text !== undefined && typeof value.text !== "string") throw new WorkspaceError("EXTENSION_CLI_RESULT_INVALID", `Extension ${plan.id} CLI text must be a string`, { extension: plan.id });
+  return { data: value.data ?? null, diagnostics, text: value.text || "" };
+}
+
+async function executeExt(invocation) {
+  const id = normalizeExtensionNames([invocation.args[0]])[0];
+  const args = invocation.args.slice(1);
+  const catalogResult = discoverExtensions({ tolerant: true });
+  const entry = catalogResult.catalog.find((candidate) => candidate.id === id);
+  if (!entry) {
+    const invalid = catalogResult.invalid.find((candidate) => candidate.id === id);
+    throw new WorkspaceError(invalid?.code || "EXTENSION_NOT_FOUND", invalid?.message || `Unknown built-in extension: ${id}`, { extension: id });
+  }
+  const resolved = entry.latestSupported;
+  if (!resolved) throw new WorkspaceError("EXTENSION_SPEC_UNSUPPORTED", `No supported Extension Spec for extension ${id}`, { extension: id });
+  if (!resolved.manifest.cli) throw new WorkspaceError("EXTENSION_CLI_UNAVAILABLE", `Extension ${id} does not provide a CLI`, { extension: id });
+  const root = findWorkspaceRoot(process.cwd());
+  const globalRuntimes = globalRuntimeRegistry(catalogResult.catalog);
+  const runtime = globalRuntimes.find((candidate) => candidate.id === id);
+  if (resolved.manifest.cli.scope === "global" && !runtime) {
+    throw new WorkspaceError("EXTENSION_GLOBAL_RUNTIME_UNAVAILABLE", `Global runtime for extension ${id} is not registered`, { extension: id });
+  }
+  let workspace = null;
+  if (resolved.manifest.cli.scope === "workspace") {
+    if (!root) throw new WorkspaceError("WORKSPACE_NOT_FOUND", `Extension ${id} requires a Code Workspace.`, { extension: id });
+    workspace = loadConfigProjection(root, ["identity", "language"]).workspace;
+  } else if (root) {
+    try { workspace = loadConfigProjection(root, ["identity", "language"]).workspace; } catch { workspace = null; }
+  }
+  const state = root ? loadExtensionState(root) : emptyExtensionState();
+  if (resolved.manifest.cli.scope === "workspace" && !state.extensions[id]?.installed) {
+    throw new WorkspaceError("EXTENSION_NOT_INSTALLED", `Extension ${id} is not installed in this Workspace`, { extension: id, remediation: `Run code-w extension install ${id} --yes.` });
+  }
+  const plan = resolveExtensionPlans([entry], [id], { tools: ["codex", "claude"], state })[0];
+  const context = { workspace, scope: resolved.manifest.cli.scope, workspaceRoot: root || null };
+  if (extensionCliIsLongRunning(plan, args)) {
+    const output = await runExtensionCliLongRunning(plan, context, args);
+    return success("ext", {
+      extension: { id: plan.id, version: plan.version },
+      scope: plan.cli.scope,
+      result: { status: output.status, signal: output.signal, longRunning: true },
+      diagnostics: [],
+    }, `Extension ${plan.id} long-running CLI exited${output.signal ? ` by ${output.signal}` : ""}.`);
+  }
+  const output = runExtensionCli(plan, context, args);
+  const parsed = parseCliOutput(output.stdout, plan);
+  return success("ext", {
+    extension: { id: plan.id, version: plan.version },
+    scope: plan.cli.scope,
+    result: parsed.data,
+    diagnostics: parsed.diagnostics,
+  }, parsed.text || undefined, parsed.diagnostics);
+}
+
+module.exports = { executeExt, parseCliOutput };
