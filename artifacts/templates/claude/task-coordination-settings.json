{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "code-workspace-task-hook claude", "timeout": 2 }] }]
  }
}
